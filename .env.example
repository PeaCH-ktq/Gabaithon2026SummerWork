# Gemini API（サーバー専用。NEXT_PUBLIC_ を付けないこと）
# 取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 任意: 使用モデル（未設定時は gemini-2.5-flash）
# GEMINI_MODEL=gemini-2.5-flash

# Supabase（詳細: doc/database.md）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。google_credentials など RLS を回避する操作にのみ使う
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth（ログイン＋カレンダー書き込み用）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
