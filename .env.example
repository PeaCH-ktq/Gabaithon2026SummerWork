# Gemini API（サーバー専用。NEXT_PUBLIC_ を付けないこと）
# 取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 任意: 使用モデルと、混雑時のフォールバックモデル
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Supabase（詳細: doc/database.md）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。google_credentials など RLS を回避する操作にのみ使う
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth（ログイン＋カレンダー書き込み用）
# 同じ値を Supabase ダッシュボード（Authentication > Providers > Google）にも設定する。
# ログインだけならダッシュボード設定のみで足りるが、カレンダー連携の Route Handler
# （app/api/calendar/events）がサーバー側で refresh token を access token に交換するため
# アプリからも読む。サーバー専用（NEXT_PUBLIC_ を付けないこと）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
